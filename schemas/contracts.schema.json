{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-daily.local/contracts.schema.json",
  "title": "知识采集系统公共契约片段",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repo": {
      "type": "object",
      "required": [
        "full_name",
        "url",
        "description",
        "language",
        "stars_total",
        "stars_today",
        "stars_today_source",
        "forks",
        "created_at",
        "pushed_at"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "description": {
          "type": ["string", "null"]
        },
        "language": {
          "type": ["string", "null"]
        },
        "stars_total": {
          "type": "integer",
          "minimum": 0
        },
        "stars_today": {
          "type": ["integer", "null"]
        },
        "stars_today_source": {
          "enum": ["local_diff", "star_history", null]
        },
        "forks": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "pushed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      }
    },
    "repeat": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["last_seen", "new_progress"],
      "properties": {
        "last_seen": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "new_progress": {
          "type": ["string", "null"]
        }
      }
    },
    "analyzedRepo": {
      "allOf": [
        { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/repo" },
        {
          "type": "object",
          "required": ["themes", "repeat", "core", "why"],
          "properties": {
            "themes": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "repeat": {
              "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/repeat"
            },
            "core": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "organizedRepo": {
      "allOf": [
        { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/analyzedRepo" },
        {
          "type": "object",
          "required": ["rank"],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "themes"],
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "note"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
