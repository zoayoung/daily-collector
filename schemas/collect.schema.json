{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-daily.local/collect.schema.json",
  "title": "collect.json（采集脚本产物）",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "collected_at", "github", "gaps"],
  "properties": {
    "date": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/date" },
    "collected_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
    },
    "github": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/repo" }
    },
    "gaps": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/gaps" }
  }
}
