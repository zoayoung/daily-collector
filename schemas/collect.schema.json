{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-daily.local/collect.schema.json",
  "title": "collect.json（采集脚本产物）",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "collected_at", "github", "gaps"],
  "properties": {
    "date": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/date" },
    "collected_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
    },
    "github": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/repo" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "eligible", "dropped_recent_duplicates"],
      "properties": {
        "candidates": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "dropped_recent_duplicates": { "type": "integer", "minimum": 0 },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["star_bands", "new_repos"],
          "properties": {
            "star_bands": { "type": "integer", "minimum": 0 },
            "new_repos": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "gaps": { "$ref": "https://knowledge-daily.local/contracts.schema.json#/$defs/gaps" }
  }
}
